# Copy this to .env and fill in the values you want to use.
# .env is loaded by the systemd scrape service (EnvironmentFile=-.env)
# The leading '-' in the service file means it's optional -- missing
# vars just mean that channel/scraper feature is skipped.

# Slack incoming webhook for the digest (optional)
SLACK_WEBHOOK_URL=

# Email digest via SMTP (optional)
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=
DIGEST_SMTP_PASS=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=

# CourtListener API token (optional, raises rate limits)
COURTLISTENER_TOKEN=

# How far back the digest looks for "new" items, in hours
DIGEST_LOOKBACK_HOURS=24
